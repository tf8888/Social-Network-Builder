# --- GitHub ---
# Personal access token, no scopes needed for public data.
# Create one at https://github.com/settings/tokens
# Using a token raises your rate limit from 60/hr to 5000/hr (core API)
# and lets the Search API work reliably (unauthenticated search is heavily throttled).
GITHUB_TOKEN=

# --- Supabase ---
SUPABASE_URL=https://tjqgzzdjcghystovcdtb.supabase.co
# Service role key (NOT the publishable/anon key) is required to write rows.
# Find it in Supabase dashboard -> Project Settings -> API -> service_role secret.
# Never commit this file or share this key.
SUPABASE_SERVICE_KEY=

# --- Run controls (demo-scale by design, see README) ---
# Hard-capped in code at 100 regardless of what you set here.
MAX_USERS=20
# Seconds to sleep between GitHub Search API calls (strict limit: ~30/min authenticated).
SEARCH_DELAY_SECONDS=2.5
# Seconds to sleep between GitHub core API calls (profile lookups).
CORE_DELAY_SECONDS=1.0
